<ui:FluentWindow x:Class="N1MM_DXK_GW.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:N1MM_DXK_GW"
                 Title="{x:Static local:Strings.AppTitle}"
                 Width="780" Height="930"
                 MinWidth="640" MinHeight="600"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">

   <Window.Resources>
      <!-- Card heading: promoted in weight and given breathing room so the
           three groups read as groups, rather than every line competing. -->
      <Style x:Key="CardHeading" TargetType="TextBlock">
         <Setter Property="FontSize" Value="15" />
         <Setter Property="FontWeight" Value="SemiBold" />
         <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <Style x:Key="HeadingIcon" TargetType="ui:SymbolIcon">
         <Setter Property="FontSize" Value="18" />
         <Setter Property="Margin" Value="0,0,10,0" />
         <Setter Property="VerticalAlignment" Value="Center" />
         <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      </Style>

      <!-- One settings row: label (with optional description) on the left,
           control hard right. This is the Fluent settings pattern and it fixes
           the uneven rhythm of two ragged checkbox columns - every row shares
           the same left edge and the same height. -->
      <Style x:Key="SettingRow" TargetType="Grid">
         <Setter Property="Margin" Value="0,0,0,2" />
      </Style>

      <Style x:Key="SettingLabel" TargetType="TextBlock">
         <Setter Property="VerticalAlignment" Value="Center" />
         <Setter Property="TextWrapping" Value="Wrap" />
         <Setter Property="Margin" Value="0,5,16,5" />
      </Style>

      <Style x:Key="SubSettingLabel" TargetType="TextBlock" BasedOn="{StaticResource SettingLabel}">
         <Setter Property="Margin" Value="26,5,16,5" />
         <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      </Style>

      <!-- BasedOn is not optional. A keyed Style with no BasedOn REPLACES the
           theme's default style rather than extending it, which strips the
           control template - the toggles rendered as bare dots without it. -->
      <Style x:Key="RowToggle" TargetType="ui:ToggleSwitch"
             BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
         <Setter Property="HorizontalAlignment" Value="Right" />
         <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <!-- Status chip: subtle filled pill so the three DXLab programs read as
           discrete states rather than as a bulleted list. -->
      <Style x:Key="StatusChip" TargetType="Border">
         <Setter Property="CornerRadius" Value="14" />
         <Setter Property="Padding" Value="12,6" />
         <Setter Property="Margin" Value="0,0,8,0" />
         <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
         <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
         <Setter Property="BorderThickness" Value="1" />
      </Style>
   </Window.Resources>

   <Grid>
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <ui:TitleBar Grid.Row="0"
                   Title="{x:Static local:Strings.AppTitle}"
                   ShowMaximize="True" />

      <Grid Grid.Row="1" Margin="18,6,18,14">
         <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
         </Grid.RowDefinitions>

         <!-- Settings and status scroll together; the log keeps the rest of the
              window. On a short window the operator can still reach every
              setting, and the log never collapses to nothing. -->
         <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="565">
            <StackPanel>

               <!-- ========================= Network ========================= -->
               <ui:Card Margin="0,0,0,10" Padding="16">
                  <StackPanel>
                     <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:SymbolIcon Symbol="Globe24" Style="{StaticResource HeadingIcon}" />
                        <TextBlock Style="{StaticResource CardHeading}"
                                   Text="{x:Static local:Strings.NetworkHeader}" />
                     </StackPanel>

                     <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="*" />
                           <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}"
                                   Text="{x:Static local:Strings.UdpPortLabel}" />
                        <ui:TextBox x:Name="UdpPortBox" Grid.Column="1"
                                    Width="120" VerticalAlignment="Center"
                                    ToolTip="{x:Static local:Strings.UdpPortTip}"
                                    KeyDown="UdpPortBox_KeyDown"
                                    LostFocus="UdpPortBox_LostFocus" />
                     </Grid>

                     <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="*" />
                           <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}"
                                   Text="{x:Static local:Strings.MulticastLabel}" />
                        <ui:TextBox x:Name="MulticastBox" Grid.Column="1"
                                    Width="200" VerticalAlignment="Center"
                                    PlaceholderText="{x:Static local:Strings.MulticastPlaceholder}"
                                    ToolTip="{x:Static local:Strings.MulticastTip}"
                                    KeyDown="MulticastBox_KeyDown"
                                    LostFocus="MulticastBox_LostFocus" />
                     </Grid>

                     <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="Auto" />
                           <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DxkPortLabel" Grid.Column="0"
                                   Style="{StaticResource SettingLabel}"
                                   Text="{x:Static local:Strings.DxKeeperPortLabel}" />
                        <TextBlock x:Name="DxkPortValue" Grid.Column="1"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{x:Static local:Strings.DxKeeperPortReading}" />
                     </Grid>
                  </StackPanel>
               </ui:Card>

               <!-- ========================= Services ======================== -->
               <ui:Card Margin="0,0,0,10" Padding="16">
                  <StackPanel>
                     <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:SymbolIcon Symbol="CloudArrowUp24" Style="{StaticResource HeadingIcon}" />
                        <TextBlock Style="{StaticResource CardHeading}"
                                   Text="{x:Static local:Strings.ServicesHeader}" />
                     </StackPanel>

                     <!-- ToggleSwitch, not CheckBox: each of these takes effect
                          the instant it is changed (saved and applied, no OK
                          button), which is exactly when Fluent calls for a
                          switch rather than a checkbox. -->
                     <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}"
                                   Text="{x:Static local:Strings.CheckDxkLookup}"
                                   ToolTip="{x:Static local:Strings.CheckDxkLookupTip}" />
                        <ui:ToggleSwitch x:Name="DxkLookupToggle" Grid.Column="1"
                                         Style="{StaticResource RowToggle}"
                                         ToolTip="{x:Static local:Strings.CheckDxkLookupTip}"
                                         Checked="SettingToggleChanged" Unchecked="SettingToggleChanged" />
                     </Grid>

                     <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}"
                                   Text="{x:Static local:Strings.CheckCallbook}"
                                   ToolTip="{x:Static local:Strings.CheckCallbookTip}" />
                        <ui:ToggleSwitch x:Name="CallbookToggle" Grid.Column="1"
                                         Style="{StaticResource RowToggle}"
                                         ToolTip="{x:Static local:Strings.CheckCallbookTip}"
                                         Checked="SettingToggleChanged" Unchecked="SettingToggleChanged" />
                     </Grid>

                     <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}"
                                   Text="{x:Static local:Strings.CheckEqsl}"
                                   ToolTip="{x:Static local:Strings.CheckEqslTip}" />
                        <ui:ToggleSwitch x:Name="EqslToggle" Grid.Column="1"
                                         Style="{StaticResource RowToggle}"
                                         ToolTip="{x:Static local:Strings.CheckEqslTip}"
                                         Checked="SettingToggleChanged" Unchecked="SettingToggleChanged" />
                     </Grid>

                     <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}"
                                   Text="{x:Static local:Strings.CheckLotw}"
                                   ToolTip="{x:Static local:Strings.CheckLotwTip}" />
                        <ui:ToggleSwitch x:Name="LotwToggle" Grid.Column="1"
                                         Style="{StaticResource RowToggle}"
                                         ToolTip="{x:Static local:Strings.CheckLotwTip}"
                                         Checked="SettingToggleChanged" Unchecked="SettingToggleChanged" />
                     </Grid>

                     <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}"
                                   Text="{x:Static local:Strings.CheckClubLog}"
                                   ToolTip="{x:Static local:Strings.CheckClubLogTip}" />
                        <ui:ToggleSwitch x:Name="ClubLogToggle" Grid.Column="1"
                                         Style="{StaticResource RowToggle}"
                                         ToolTip="{x:Static local:Strings.CheckClubLogTip}"
                                         Checked="SettingToggleChanged" Unchecked="SettingToggleChanged" />
                     </Grid>
                  </StackPanel>
               </ui:Card>

               <!-- ======================= Diagnostics ======================= -->
               <ui:Card Margin="0,0,0,10" Padding="16">
                  <StackPanel>
                     <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:SymbolIcon Symbol="DocumentBulletList24" Style="{StaticResource HeadingIcon}" />
                        <TextBlock Style="{StaticResource CardHeading}"
                                   Text="{x:Static local:Strings.DiagnosticsHeader}" />
                     </StackPanel>

                     <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}"
                                   Text="{x:Static local:Strings.CheckDebugLogging}"
                                   ToolTip="{x:Static local:Strings.CheckDebugLoggingTip}" />
                        <ui:ToggleSwitch x:Name="DebugLogToggle" Grid.Column="1"
                                         Style="{StaticResource RowToggle}"
                                         ToolTip="{x:Static local:Strings.CheckDebugLoggingTip}"
                                         Checked="DebugLogToggle_Changed" Unchecked="DebugLogToggle_Changed" />
                     </Grid>

                     <!-- Indented and dimmed: a sub-option of the row above. -->
                     <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SubSettingLabel}"
                                   Text="{x:Static local:Strings.CheckVerboseLogging}"
                                   ToolTip="{x:Static local:Strings.CheckVerboseLoggingTip}" />
                        <ui:ToggleSwitch x:Name="VerboseLogToggle" Grid.Column="1"
                                         Style="{StaticResource RowToggle}"
                                         ToolTip="{x:Static local:Strings.CheckVerboseLoggingTip}"
                                         Checked="SettingToggleChanged" Unchecked="SettingToggleChanged" />
                     </Grid>
                  </StackPanel>
               </ui:Card>
            </StackPanel>
         </ScrollViewer>

         <!-- ====================== Connection Status ====================== -->
         <ui:Card Grid.Row="1" Margin="0,0,0,10" Padding="16">
            <StackPanel>
               <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <ui:SymbolIcon Symbol="PlugConnected24" Style="{StaticResource HeadingIcon}" />
                  <TextBlock Style="{StaticResource CardHeading}"
                             Text="{x:Static local:Strings.StatusHeader}" />
               </StackPanel>
               <!-- Three status chips on one row: compact, and the whole
                    DXLab picture is legible at a glance instead of as a list. -->
               <StackPanel Orientation="Horizontal">
                  <Border x:Name="DxkChip" Style="{StaticResource StatusChip}">
                     <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="DxkDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="DXKeeper" FontWeight="SemiBold" Margin="0,0,6,0" />
                        <TextBlock x:Name="DxkStatus" />
                     </StackPanel>
                  </Border>
                  <Border x:Name="DxvChip" Style="{StaticResource StatusChip}">
                     <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="DxvDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="DXView" FontWeight="SemiBold" Margin="0,0,6,0" />
                        <TextBlock x:Name="DxvStatus" />
                     </StackPanel>
                  </Border>
                  <Border x:Name="PfChip" Style="{StaticResource StatusChip}">
                     <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="PfDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Pathfinder" FontWeight="SemiBold" Margin="0,0,6,0" />
                        <TextBlock x:Name="PfStatus" />
                     </StackPanel>
                  </Border>
               </StackPanel>
            </StackPanel>
         </ui:Card>

         <!-- ========================= Operation log ======================== -->
         <ui:Card Grid.Row="2" Margin="0,0,0,10" Padding="16">
            <Grid>
               <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
               </Grid.RowDefinitions>

               <Grid Grid.Row="0" Margin="0,0,0,10">
                  <StackPanel Orientation="Horizontal">
                     <ui:SymbolIcon Symbol="TextBulletListSquare24" Style="{StaticResource HeadingIcon}" />
                     <TextBlock Style="{StaticResource CardHeading}"
                                Text="{x:Static local:Strings.LogHeader}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                     <ui:Button x:Name="CopyLogButton" Appearance="Transparent" Margin="0,0,4,0"
                                Icon="{ui:SymbolIcon Copy24}"
                                Content="{x:Static local:Strings.LogCopy}"
                                ToolTip="{x:Static local:Strings.LogCopyTip}"
                                Click="CopyLogButton_Click" />
                     <ui:Button x:Name="ClearLogButton" Appearance="Transparent"
                                Icon="{ui:SymbolIcon Eraser24}"
                                Content="{x:Static local:Strings.LogClear}"
                                ToolTip="{x:Static local:Strings.LogClearTip}"
                                Click="ClearLogButton_Click" />
                  </StackPanel>
               </Grid>

               <!-- Monospace stays: timestamps and callsigns align into columns
                    the operator scans during a run. Severity drives colour so
                    a failure stands out without reading every line. -->
               <ListBox x:Name="OperationLogList" Grid.Row="1"
                        FontFamily="Consolas" FontSize="12"
                        BorderThickness="0" Background="Transparent"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        VirtualizingStackPanel.IsVirtualizing="True">
                  <ListBox.ItemContainerStyle>
                     <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="2,1,2,1" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                     </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                     <DataTemplate DataType="{x:Type local:LogEntry}">
                        <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" />
                     </DataTemplate>
                  </ListBox.ItemTemplate>
               </ListBox>
            </Grid>
         </ui:Card>

         <!-- =================== Notice + footer commands =================== -->
         <StackPanel Grid.Row="3">
            <!-- A real InfoBar rather than a coloured sentence with links: this
                 is a standing condition needing an action, which is exactly
                 what InfoBar is for. -->
            <ui:InfoBar x:Name="FailedQsoBar"
                        Severity="Warning"
                        IsOpen="False"
                        IsClosable="False"
                        Margin="0,0,0,10"
                        Title="{x:Static local:Strings.FailedQsoBarTitle}">
               <ui:InfoBar.Content>
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                     <ui:Button x:Name="FailedQsoFileButton" Margin="0,0,8,0"
                                Icon="{ui:SymbolIcon Document24}"
                                Content="{x:Static local:Strings.OpenFileButton}"
                                Click="FailedQsoFileLink_Click" />
                     <ui:Button x:Name="FailedQsoFolderButton"
                                Icon="{ui:SymbolIcon FolderOpen24}"
                                Content="{x:Static local:Strings.OpenFolderButton}"
                                Click="FailedQsoFolderLink_Click" />
                  </StackPanel>
               </ui:InfoBar.Content>
            </ui:InfoBar>

            <Grid>
               <ui:HyperlinkButton x:Name="ErrorLogLink"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Visibility="Collapsed" Padding="0"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   Content="{x:Static local:Strings.SeeErrorLog}"
                                   Click="ErrorLogLink_Click" />
               <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <ui:Button x:Name="ShowErrorLogButton" Margin="0,0,8,0"
                             Icon="{ui:SymbolIcon DocumentError24}"
                             Content="{x:Static local:Strings.DisplayErrorLog}"
                             Click="ShowErrorLogButton_Click" />
                  <ui:Button x:Name="HelpButton"
                             Icon="{ui:SymbolIcon QuestionCircle24}"
                             Content="{x:Static local:Strings.Help}"
                             Click="HelpButton_Click" />
               </StackPanel>
            </Grid>
         </StackPanel>
      </Grid>
   </Grid>
</ui:FluentWindow>
