<ui:FluentWindow x:Class="N1MM_DXK_GW.AboutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:N1MM_DXK_GW"
                 Title="{x:Static local:Strings.AboutTitle}"
                 Width="520" SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ShowInTaskbar="False">

   <Grid>
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <ui:TitleBar Grid.Row="0" Title="{x:Static local:Strings.AboutTitle}"
                   ShowMaximize="False" ShowMinimize="False" />

      <StackPanel Grid.Row="1" Margin="24,8,24,18">
         <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Image x:Name="AppIcon" Width="40" Height="40" Margin="0,0,14,0"
                   VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
               <TextBlock Text="{x:Static local:Strings.AppTitle}"
                          FontSize="19" FontWeight="SemiBold" />
               <TextBlock x:Name="VersionText" Opacity="0.75" FontSize="13" />
            </StackPanel>
         </StackPanel>

         <TextBlock Text="{x:Static local:Strings.AboutPurpose}"
                    TextWrapping="Wrap" Margin="0,12,0,0" />

         <TextBlock x:Name="CopyrightText" Margin="0,12,0,0" Opacity="0.85" />

         <TextBlock Text="{x:Static local:Strings.AboutLicenceShort}"
                    TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.85" />

         <!-- Collapsed when the running language has no attribution, which is
              only the case for a satellite someone has emptied by hand. -->
         <TextBlock x:Name="TranslationCredit" TextWrapping="Wrap"
                    Margin="0,12,0,0" Opacity="0.85" />

         <TextBlock Text="{x:Static local:Strings.AboutOriginal}"
                    TextWrapping="Wrap" Margin="0,12,0,0"
                    Opacity="0.7" FontSize="12" />
      </StackPanel>

      <Border Grid.Row="2" Padding="24,14"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
         <Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
               <ui:Button x:Name="ReadmeButton"
                          Content="{x:Static local:Strings.ReadmeButton}"
                          Icon="{ui:SymbolIcon BookOpen24}"
                          Click="Readme_Click" Margin="0,0,8,0" />
               <ui:Button Content="{x:Static local:Strings.NoticeViewLicence}"
                          Icon="{ui:SymbolIcon DocumentText24}"
                          Click="ViewLicence_Click" Margin="0,0,8,0" />
               <!-- Testers quote versions inaccurately from memory; this puts
                    the exact build and environment on the clipboard for them. -->
               <ui:Button Content="{x:Static local:Strings.AboutCopyProfile}"
                          Icon="{ui:SymbolIcon Copy24}"
                          Click="CopyProfile_Click" />
            </StackPanel>
            <ui:Button Content="{x:Static local:Strings.AboutClose}"
                       Appearance="Primary" IsDefault="True" IsCancel="True"
                       MinWidth="96" HorizontalAlignment="Right"
                       Click="Close_Click" />
         </Grid>
      </Border>
   </Grid>
</ui:FluentWindow>
