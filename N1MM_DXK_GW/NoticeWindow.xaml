<ui:FluentWindow x:Class="N1MM_DXK_GW.NoticeWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:N1MM_DXK_GW"
                 Title="{x:Static local:Strings.NoticeTitle}"
                 Width="560" SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 ShowInTaskbar="False">

   <Grid>
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <ui:TitleBar Grid.Row="0" Title="{x:Static local:Strings.NoticeTitle}"
                   ShowMaximize="False" ShowMinimize="False" ShowClose="False" />

      <StackPanel Grid.Row="1" Margin="24,8,24,16">
         <TextBlock Text="{x:Static local:Strings.NoticeHeading}"
                    FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />

         <TextBlock Text="{x:Static local:Strings.NoticeFreeSoftware}"
                    TextWrapping="Wrap" Margin="0,0,0,12" />

         <!-- The reason this window exists, so it gets the visual weight: a
              card with an accent edge rather than another paragraph. -->
         <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                 BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                 BorderThickness="4,0,0,0" CornerRadius="4"
                 Padding="14,12" Margin="0,0,0,12">
            <TextBlock Text="{x:Static local:Strings.NoticeWarranty}"
                       TextWrapping="Wrap" />
         </Border>

         <TextBlock Text="{x:Static local:Strings.NoticeWhereToFind}"
                    TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
      </StackPanel>

      <Border Grid.Row="2" Padding="24,14"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- The read-me is offered here as well as in About because this
                 is the one moment we know the operator is new to the program
                 and has not yet been told anything. -->
            <ui:Button Content="{x:Static local:Strings.ReadmeButton}"
                       Icon="{ui:SymbolIcon BookOpen24}"
                       Click="Readme_Click" Margin="0,0,10,0" />
            <ui:Button Content="{x:Static local:Strings.NoticeViewLicence}"
                       Icon="{ui:SymbolIcon DocumentText24}"
                       Click="ViewLicence_Click" Margin="0,0,10,0" />
            <!-- IsDefault so Enter dismisses it: this is an acknowledgement,
                 not a decision, and there is no second option to weigh. -->
            <ui:Button Content="{x:Static local:Strings.NoticeUnderstood}"
                       Appearance="Primary" IsDefault="True"
                       MinWidth="120" Click="Understood_Click" />
         </StackPanel>
      </Border>
   </Grid>
</ui:FluentWindow>
